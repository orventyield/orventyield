{
  // Verification API (phone OTP + one-user-one-card). Deploy separately from the static site.
  // One-time setup:
  //   1. npx wrangler d1 create orventyield-verify              -> copy the database_id below
  //   2. npx wrangler d1 migrations apply DB --remote --config worker/wrangler.jsonc
  //   3. secrets (npx wrangler secret put NAME --config worker/wrangler.jsonc):
  //        PEPPER (random 32+ chars; never change it, it keys every stored hash)
  //        TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_VERIFY_SERVICE_SID
  //      In the Twilio console: enable Verify Fraud Guard and restrict geo permissions to the countries you serve.
  //   4. npx wrangler deploy --config worker/wrangler.jsonc, then serve it on a subdomain (e.g. verify.orventyield.tech)
  //   5. build the web app with NEXT_PUBLIC_VERIFY_API_URL=https://verify.orventyield.tech
  //   6. vouchers (optional): npx wrangler secret put BITREFILL_API_KEY --config worker/wrangler.jsonc
  //      (a Personal key from bitrefill.com > Account > Developers, or BITREFILL_API_ID + BITREFILL_API_SECRET for a
  //      Business account) and set the BITREFILL_BASE_URL var to the API base shown in docs.bitrefill.com.
  //      Until both are set, /api/vouchers/* answers 503 and the app says vouchers are not available yet.
  //      Add a Cloudflare rate-limiting rule for /api/vouchers/* (the in-code limiter is per-isolate only).
  //   7. bank / UPI cashout (optional): get a STAGING partner key at dashboard.transak.com, then
  //        npx wrangler secret put TRANSAK_API_KEY / TRANSAK_API_SECRET --config worker/wrangler.jsonc
  //      Run `npm run cashout:probe` first: it confirms which order field is the payment address; put that field name in the
  //      TRANSAK_DEPOSIT_FIELD var below. Until it is set the app refuses to send any cashout. TRANSAK_ENV defaults to staging.
  //      Production needs KYB approval plus explicit TRANSAK_ENV=production, TRANSAK_GATEWAY_BASE and TRANSAK_PARTNERS_BASE.
  //   8. SMS troubleshooting: when a code cannot be sent, the Worker logs one JSON line, e.g.
  //        {"evt":"otp_provider_failed","operation":"start","httpStatus":403,"providerCode":60410,"userCode":"SMS_BLOCKED","country":"IN"}
  //      Read it with `npx wrangler tail --config worker/wrangler.jsonc` or in the Cloudflare dashboard (Workers Logs). It never
  //      contains the phone number. 60410/60605 = Twilio Fraud Guard blocked a region (usually clears in 12h); 21608 = unverified
  //      number on a trial account; 60205/60612 = landline or not a mobile; 60610/60607 = unsupported country.
  // Never set ALLOW_MOCK_OTP in production: it enables the fixed test code.
  "name": "orventyield-verify",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  // Keep Worker logs (including the otp_provider_failed lines) in the Cloudflare dashboard, not just in `wrangler tail`.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orventyield-verify",
      "database_id": "d1af791f-eea0-40fc-9249-1d12caabb088",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OTP_PROVIDER": "twilio",
    "OTP_BRAND": "OrventYield",
    "ALLOWED_ORIGINS": "https://orventyield.tech,https://www.orventyield.tech,http://localhost:3000"
  }
}
