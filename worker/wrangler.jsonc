{
  // API broker for vouchers and bank / UPI cashout. Stateless: no database. Deploy separately from the static site.
  // One-time setup:
  //   1. npx wrangler deploy --config worker/wrangler.jsonc, then serve it on a subdomain (e.g. verify.orventyield.tech)
  //   2. build the web app with NEXT_PUBLIC_VERIFY_API_URL=<that URL> (the name is historical; it is the Worker base URL)
  //   3. vouchers (optional): npx wrangler secret put BITREFILL_API_KEY --config worker/wrangler.jsonc
  //      (a Personal key from bitrefill.com > Account > Developers, or BITREFILL_API_ID + BITREFILL_API_SECRET for a
  //      Business account) and set the BITREFILL_BASE_URL var to the API base shown in docs.bitrefill.com.
  //      Until both are set, /api/vouchers/* answers 503 and the app says vouchers are not available yet.
  //      Add a Cloudflare rate-limiting rule for /api/vouchers/* (the in-code limiter is per-isolate only).
  //   4. bank / UPI cashout (optional): get a STAGING partner key at dashboard.transak.com, then
  //        npx wrangler secret put TRANSAK_API_KEY / TRANSAK_API_SECRET --config worker/wrangler.jsonc
  //      Run `npm run cashout:probe` first: it confirms which order field is the payment address; put that field name in the
  //      TRANSAK_DEPOSIT_FIELD var below. Until it is set the app refuses to send any cashout. TRANSAK_ENV defaults to staging.
  //      Production needs KYB approval plus explicit TRANSAK_ENV=production, TRANSAK_GATEWAY_BASE and TRANSAK_PARTNERS_BASE.
  // The Worker keeps its historical name so the deployed URL does not change.
  "name": "orventyield-verify",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  // Keep Worker logs in the Cloudflare dashboard, not just in `wrangler tail`.
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://orventyield.tech,https://www.orventyield.tech,http://localhost:3000",
    "BITREFILL_BASE_URL": "https://api.bitrefill.com/v2"
  }
}
