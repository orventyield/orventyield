# Copy to .env.local. Never commit real values.
# NEXT_PUBLIC_* is exposed to the browser; treat it as public. Marketing pages need none of these.

# --- Wallet connection ---
# Free project id from https://cloud.reown.com (create a project and add your domain).
# Without it the WalletConnect (QR / mobile wallet) option is hidden; browser extensions and
# Coinbase Wallet still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- RPC endpoints (optional; the public ones are rate limited) ---
# Ether.fi Cash runs on Optimism, so that is the one that matters.
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_SCROLL=

# --- Local Anvil fork (development only; never enabled on the public site) ---
NEXT_PUBLIC_ENABLE_LOCAL_FORK=
NEXT_PUBLIC_LOCAL_FORK_RPC=http://127.0.0.1:8545

# --- API Worker (vouchers and bank / UPI cashout, see worker/) ---
# Base URL of the deployed Worker. The name is historical. Leave empty to show vouchers and cashout as "coming soon".
NEXT_PUBLIC_VERIFY_API_URL=

# --- Card issuer (Immersve) ---
# Unset = Immersve's PUBLIC SANDBOX (test.immersve.com, a test network, test cards). For production set ALL of these at build
# time to the values from your Immersve partner onboarding (they are not public and are never guessed here):
#   NEXT_PUBLIC_IMMERSVE_BASE_URL=https://api.immersve.com
#   NEXT_PUBLIC_IMMERSVE_CLIENT_APP_ID=
#   NEXT_PUBLIC_IMMERSVE_PARTNER_ID=
#   NEXT_PUBLIC_IMMERSVE_CARD_PROGRAM_ID=
#   NEXT_PUBLIC_IMMERSVE_FUNDING_CHANNEL_ID=   (the Arbitrum One USDC channel)
#   NEXT_PUBLIC_IMMERSVE_NETWORK=
#   NEXT_PUBLIC_IMMERSVE_FUNDS_STORAGE=        (the channel's funds-storage address; unset keeps production funding off)
