# Copy to .env.local. Never commit real values.
# NEXT_PUBLIC_* is exposed to the browser; treat as public. The landing page needs none of these yet.

# WalletConnect project id (free at cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC endpoints (free tiers: Alchemy / Infura / public). Falls back to public RPC if empty.
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_SCROLL=

# Default chain id (42161 Arbitrum, 8453 Base, 534352 Scroll)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=

# Third-party widgets (only if required by their terms)
NEXT_PUBLIC_BITREFILL_REF=
NEXT_PUBLIC_TRANSAK_API_KEY=
