# Copy to .env.local. Never commit real values.
# NEXT_PUBLIC_* is exposed to the browser; treat it as public. Marketing pages need none of these.

# --- Wallet connection ---
# Free project id from https://cloud.reown.com (create a project and add your domain).
# Without it the WalletConnect (QR / mobile wallet) option is hidden; browser extensions and
# Coinbase Wallet still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- RPC endpoints (optional; the public ones are rate limited) ---
# Ether.fi Cash runs on Optimism, so that is the one that matters.
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_SCROLL=

# --- Local Anvil fork (development only; never enabled on the public site) ---
NEXT_PUBLIC_ENABLE_LOCAL_FORK=
NEXT_PUBLIC_LOCAL_FORK_RPC=http://127.0.0.1:8545

# --- Phone verification (one user = one card) ---
# URL of the verification Worker (see worker/). Leave empty to use the built-in Playground demo verifier
# (accepts code 123456, registry lives in the browser only: a demo, not a security boundary).
NEXT_PUBLIC_VERIFY_API_URL=
