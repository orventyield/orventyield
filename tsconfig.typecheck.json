{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "worker/**/*.ts",
    "*.ts",
    "*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-dev",
    ".next-build",
    ".next-e2e",
    "out"
  ]
}